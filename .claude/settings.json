{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.development.local)",
      "Read(.env.test.local)",
      "Read(.env.production.local)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.development.local)",
      "Read(**/.env.test.local)",
      "Read(**/.env.production.local)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Bash|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/block-env-local.sh\"",
            "timeout": 10,
            "statusMessage": "Checking for dotenv access"
          }
        ]
      }
    ]
  }
}
