NEXT_PUBLIC_BASE_URL=

# Neon owner connection string. Used only by `npm run db:setup` (applies db/schema.sql) and
# `npm run db:roles` (applies db/roles.sql); never read by the running app or by `npm run ingest`.
DATABASE_ADMIN_URL=

# Postgres (Neon) connection string for the running app, as the least-privilege `ask_app` role:
# read on the corpus, insert-only on documents/chunks, full access on identity and traffic
# tables. Built by `npm run db:roles`, which prints this value; paste it here, it is not derived
# automatically. See db/roles.sql for the full grant matrix and why the split exists.
DATABASE_URL=

# Postgres (Neon) connection string for `npm run ingest`, as the least-privilege `ask_ingest`
# role: full read/write on the corpus tables only, no access to identity or traffic tables. Built
# by `npm run db:roles`, which prints this value; paste it here.
DATABASE_INGEST_URL=

# API key for OpenAI's embeddings API, used by the ask agent's ingest script and query path.
OPENAI_API_KEY=

# API key for Anthropic's Messages API, used by the ask agent's generation call
# (lib/ask/generate.ts) to write the grounded answer once retrieval and grading pass.
ANTHROPIC_API_KEY=

# Seed for the ask agent's daily-rotated IP-hashing salt (docs/ask-agent/07-identity-gate.md:
# "The salt derives as HMAC(seed, utcDate)"). Read by lib/ask/session.ts to hash a visitor's IP
# before it is stored on the sessions row; a static, unsalted hash of an IPv4 address is
# brute-forceable in seconds, which is why this rotates daily instead of being a fixed value.
IP_HASH_SALT_SEED=

# The apex domain /api/ask asserts the request Host against in production
# (docs/ask-agent/07-identity-gate.md: "/api/ask returns 503 unless VERCEL_ENV === 'production'
# and the request Host matches the apex domain"). Only read when VERCEL_ENV is 'production';
# unset locally and on preview deployments, where the route is expected to 503.
APEX_HOST=

# Optional. Sets the ask_ingest role's password when `npm run db:roles` runs, instead of
# generating a random one, so reruns are reproducible. Leave unset to let db:roles generate and
# print a fresh password each run.
ASK_INGEST_PASSWORD=

# Optional. Same as ASK_INGEST_PASSWORD, for the ask_app role.
ASK_APP_PASSWORD=
