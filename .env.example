# Base URL for building UTM-tagged links. See docs/utm-tracking.md.
NEXT_PUBLIC_BASE_URL=

# Neon connection string. Point local development at the `development` branch, never `production`:
# ingest and the eval suite both write. See docs/environments.md for the branch-per-target matrix.
DATABASE_URL=

# Embeddings for ingest and the query path (lib/ask/embed.ts).
OPENAI_API_KEY=

# Read by createAnthropic() in lib/ask/generate.ts; a missing key surfaces as a stream error.
ANTHROPIC_API_KEY=

# Clerk instance keys, read by @clerk/nextjs. Development instance keys start pk_test_/sk_test_.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
